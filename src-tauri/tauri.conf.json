{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPwd",
  "version": "2.0.0",
  "identifier": "com.quickpwd.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "QuickPwd",
        "url": "launcher.html",
        "width": 680,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "center": true
      },
      {
        "label": "manager",
        "title": "QuickPwd · 密码库",
        "url": "manager.html",
        "width": 920,
        "height": 620,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
